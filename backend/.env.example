# ============================================================
# 后端环境变量示例：复制为 backend/.env 后会被自动加载（系统环境变量优先级更高）
# ============================================================

# 服务端口
SERVER_PORT=8080
# 可选：dev 使用 H2 + 内存 TokenStore，无需 MySQL/Redis。
# 启用方式：IDEA 运行配置的 Active profiles 填 dev，或命令行加 -Dspring-boot.run.profiles=dev。
# 注意：本文件若被 IDEA 当作运行配置的 env 文件加载，注释行也会被注入为环境变量；
# 因此不要在这里保留注释掉的变量赋值行，否则可能被 Spring Boot 宽松绑定后意外激活 dev。

# ---- MySQL（Druid 连接池）----
# 本机 Docker：改 DB_HOST 即可；外部数据库建议直接填 DB_URL（可包含 SSL / 超时参数）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_video
DB_USERNAME=aivideo
DB_PASSWORD=aivideo123
# 外部数据库整串覆盖示例：
# DB_URL=jdbc:mysql://db.example.com:3306/ai_video?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=true&requireSSL=true
# 首次连接外部库时设为 always，自动执行 classpath:db/schema.sql（幂等）
DB_INIT_MODE=never
# 连接池参数（默认值适用于中小流量；按数据库规格调整）
DB_POOL_INITIAL_SIZE=5
DB_POOL_MIN_IDLE=5
DB_POOL_MAX_ACTIVE=20
DB_POOL_MAX_WAIT=60000

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
# Redis 6+ ACL 用户名，没有就留空
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
# redis | memory（memory 仅用于无 Redis 的本地演示）
TOKEN_STORE=redis

# ---- JWT（生产环境必须替换）----
JWT_SECRET=aivideo-studio-dev-secret-key-please-change-in-production-2026
JWT_ACCESS_TTL=PT30M
JWT_REFRESH_TTL=P7D

# ---- 对象存储（本阶段占位，不实际写入）----
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aivideo
MINIO_PRESIGNED_TTL=PT15M

# ---- Seedance 视频生成 ----
# mock | seedance。使用 seedance 时必须设置 API Key。
VIDEO_PROVIDER=mock
ARK_API_KEY=
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL=doubao-seedance-2-5-260628
SEEDANCE_REQUEST_TIMEOUT=PT15S
# polling | callback | hybrid。本地默认 polling。
SEEDANCE_STATUS_SYNC_MODE=polling
SEEDANCE_POLL_INTERVAL=PT5S
# callback / hybrid 模式需要公网 HTTPS 地址；secret 用于回调签名。
SEEDANCE_CALLBACK_BASE_URL=
SEEDANCE_CALLBACK_SECRET=
SEEDANCE_CALLBACK_FALLBACK_INTERVAL=PT2M
SEEDANCE_MAX_SUBMIT_ATTEMPTS=3
SEEDANCE_MAX_BATCH_SIZE=20
SEEDANCE_WORKER_LEASE=PT2M
# 官方单价快照：Seedance 2.5，输入不含视频，单位元/百万 token。
SEEDANCE_PRICE_480P=70.00
SEEDANCE_PRICE_720P=70.00
SEEDANCE_PRICE_1080P=77.00

# ---- AgentScope / DeepSeek ----
AGENTSCOPE_ENABLED=false
AGENTSCOPE_MODEL=deepseek:deepseek-v4-flash
# 启用真实模型时必填；留空且 AGENTSCOPE_ENABLED=true 会启动失败
DEEPSEEK_API_KEY=
# 可选：代理/私有网关地址
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 单次模型调用超时（ISO-8601），需小于前端 20s 请求超时
AGENTSCOPE_TIMEOUT=PT15S
# ReAct 最大迭代次数 / 模型调用最大尝试次数
AGENTSCOPE_MAX_ITERS=3
AGENTSCOPE_MAX_ATTEMPTS=1
# 工具确认挂起有效期（ISO-8601）；超时后确认接口返回 40900
AGENTSCOPE_CONFIRM_TIMEOUT=PT5M
